// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  plan      String   @default("free") // free, pro, premium
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts         Post[]
  userAiKeys    UserAiKey[]
  subscriptions Subscription[]
  usageLogs     UsageLog[]
  dailyUsage    DailyUsage[]

  @@map("users")
}

model Post {
  id        String   @id @default(cuid())
  userId    String
  platform  String   // facebook, instagram, etc.
  template  String?  // optional template used
  input     String   // user input
  output    String   // generated content
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("posts")
}

model UserAiKey {
  id       String @id @default(cuid())
  userId   String
  provider String // openai, gemini, claude, openrouter
  key      String // encrypted
  iv       String
  authTag  String
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("user_ai_keys")
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  plan      String
  status    String   @default("active") // active, expired, cancelled
  startDate DateTime
  endDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model UsageLog {
  id          String   @id @default(cuid())
  userId      String
  provider    String
  model       String?
  tokensInput  Int?
  tokensOutput Int?
  estimatedCost Float?
  requestType String   @default("generate")
  status      String   @default("success")
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("usage_logs")
}

model DailyUsage {
  id         String   @id @default(cuid())
  userId     String
  date       DateTime
  postsGenerated Int @default(0)
  tokensUsed Int     @default(0)
  cost       Float   @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_usage")
}
